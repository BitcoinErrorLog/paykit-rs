  "sealed_blob_v2": {
    "description": "Sealed Blob v2 encryption test vector with deterministic inputs for roundtrip testing",
    "vectors": [
      {
        "description": "Deterministic v2 inputs for encrypt-then-decrypt roundtrip verification",
        "inputs": {
          "recipient_sk_hex": "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a",
          "recipient_pk_hex": "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a",
          "ephemeral_sk_hex": "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb",
          "ephemeral_pk_hex": "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f",
          "nonce_hex": "000000000000000000000000000000000000000000000001",
          "plaintext": "Hello, Paykit!",
          "aad": "paykit:v0:request:testowner:/pub/paykit.app/v0/requests/ctx123/req001:req001"
        },
        "derived": {
          "shared_secret_note": "X25519(ephemeral_sk, recipient_pk)",
          "salt_note": "ephemeral_pk || recipient_pk (64 bytes)",
          "hkdf_info": "pubky-envelope/v2"
        },
        "expected_envelope_fields": {
          "v": 2,
          "epk_base64url": "3p7bfXt9wbTTW2HC7OQ1Nz-DQ8hbeGdNrfx-FG-IK08",
          "nonce_base64url": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAB"
        },
        "notes": "Use these inputs for roundtrip testing. In production, ephemeral keys and nonces are random, so ciphertext is not deterministic."
      }
    ],
    "notes": [
      "ephemeral_pk derived from ephemeral_sk via X25519 basepoint multiplication",
      "Base64url encoding: RFC 4648 §5, no padding",
      "epk is 32 bytes -> 43 base64url chars",
      "nonce is 24 bytes -> 32 base64url chars",
      "HKDF salt = ephemeral_pk || recipient_pk (64 bytes)",
      "HKDF info = 'pubky-envelope/v2'",
      "AEAD = XChaCha20-Poly1305",
      "Ciphertext is not frozen in this vector because production envelopes use random ephemeral keys and nonces"
    ]
  },

  "sealed_blob_v1_compat": {
    "description": "Sealed Blob v1 backward compatibility vectors",
    "vectors": [
      {
        "description": "V1 envelope structure (deterministic inputs, decrypt-only)",
        "inputs": {
          "recipient_sk_hex": "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a",
          "recipient_pk_hex": "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a",
          "ephemeral_pk_hex": "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f",
          "nonce_hex": "000000000000000000000001",
          "plaintext": "test"
        },
        "derived": {
          "hkdf_info": "paykit-sealed-blob-v1"
        },
        "expected_envelope_fields": {
          "v": 1,
          "epk_base64url": "3p7bfXt9wbTTW2HC7OQ1Nz-DQ8hbeGdNrfx-FG-IK08",
          "nonce_base64url": "AAAAAAAAAAAAAAAB",
          "ct_note": "ChaCha20-Poly1305 ciphertext of 'test'; actual value is implementation-specific until frozen"
        }
      },
      {
        "description": "Frozen v1 envelope from pubky-noise test suite (cross-platform verification)",
        "frozen_envelope": {
          "v": 1,
          "epk": "QrcZC6lKhz5XVTbIiLMORfdFl1KRz0B9D4RgvgE5Vms",
          "nonce": "AQIDBAUGBwgJCgsM",
          "ct": "YY0tmQsVUbOOb_4Z8w7wpZFM1lQ3S5qXgxI"
        },
        "inputs": {
          "recipient_sk_hex": "1022334455667788990011121314151617181920212223242526272829ee7f40",
          "note": "recipient_sk is clamped (sk[0] &= 248, sk[31] &= 127, sk[31] |= 64)",
          "aad": "test:v1:compat"
        },
        "expected_plaintext": "v1 test data",
        "notes": "This is a frozen envelope from pubky-noise. Decrypt with recipient_sk and aad to verify v1 compatibility."
      }
    ],
    "notes": [
      "v1 nonce is 12 bytes -> 16 base64url chars",
      "v1 HKDF info = 'paykit-sealed-blob-v1'",
      "v1 AEAD = ChaCha20-Poly1305 (not XChaCha)",
      "Implementations MUST support v1 decryption",
      "The frozen envelope vector enables cross-platform verification"
    ]
  },

