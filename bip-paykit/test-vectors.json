          "ends_at": null
        },
        "nonce_hex": "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20",
        "timestamp": 1704067200,
        "expires_at": 1706745600,
        "signer_sk_hex": "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
